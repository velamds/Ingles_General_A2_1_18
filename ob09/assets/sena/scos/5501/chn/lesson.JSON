esponses": [{"correct": 0, "_data": [{"type": "text", "content": ""}], "id": 0, "selected": 0}, {"correct": 1, "_data": [{"type": "text", "content": ""}], "id": 1, "selected": 0}]}], "stimuli_ids": [], "id": 11, "type": "TYP", "_data": [{"type": "instructions", "contents": [{"type": "text", "content": "Do you have any suggestions for me?"}]}, {"type": "group", "contents": [{"type": "group_name", "content": "Activity 2"}]}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}, {"type": "learning_skills", "contents": [{"type": "skill", "content": "Writing"}, {"type": "skill", "content": "Reading"}, {"type": "skill", "content": "Listening"}, {"type": "skill", "content": "Speaking"}]}, {"type": "post_instructions", "contents": [{"type": "text", "content": "Instructions: <span class=\"bullet\">Listen to the audio.</span> <span class=\"bullet\">Type in the missing words. </span><span class=\"bullet\">Record yourself saying the sentences aloud. </span>"}, {"type": "text", "content": "You have 2 attempts to submit your answers."}]}], "template_override": 1}], "id": 0, "type": "scholar", "_data": [{"type": "lab_options", "contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}]}]}], "_data": [{"type": "metadata", "contents": [{"type": "lesson_name", "content": "Vanessa's Part-Time Job"}, {"type": "unit_name", "content": "The Performance Review"}, {"type": "position", "content": 9}, {"type": "origin", "content": "scholar > Achievement Test > Achievement Test"}, {"type": "lesson", "content": 18}, {"type": "level", "content": "A2.1"}]}, {"type": "achievment_test", "contents": [{"type": "test", "content": "false"}]}, {"type": "objectives", "contents": [{"type": "primary", "content": " Use information about personal and professional plans for the future in social and work situations."}, {"type": "secondary_1", "content": " Identifies general information in short written or spoken conversations."}, {"type": "secondary_2", "content": " Identifies general information in short written or spoken conversations."}, {"type": "secondary_3", "content": " Identifies general information in short written or spoken conversations."}, {"type": "secondary_4", "content": " Identifies general information in short written or spoken conversations."}, {"type": "secondary_5", "content": " Identifies general information in short written or spoken conversations."}, {"type": "secondary_6", "content": " Identifies general information in short written or spoken conversations."}, {"type": "secondary_7", "content": " Identifies general information in short written or spoken conversations."}, {"type": "secondary_8", "content": " Identifies general information in short written or spoken conversations."}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": " Responding to Suggestions "}, {"type": "describer", "content": " It's important to respond to suggestions others make. We can politely express that we like the idea or not. <br />  <br />Look at the chart below."}, {"type": "table", "content": "{\"rows\":4,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\"> Accepting a Suggesting </span> \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\"> Declining a Suggestion </span> \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Yeah, that sounds great. Thank you.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" I don't think so, but thanks anyway.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" That's a great idea. Thanks.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" I don't know if that's a good idea. Thanks anyway.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" I like that. Thanks.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" I'm not sure that would work. Thanks anyway.\\\"}\"],\"styles\":\" instruction_table_background intro_table_border\"}"}, {"type": "example", "content": "<span class=\"strong\">Alan</span>: Why don't we ask John to come to the meeting?<br ><span class=\"strong\">Annette</span>: Hey, that's a great idea."}, {"type": "example", "content": "<span class=\"strong\">Alan</span>: Could we maybe hang that chart on the back of the door?<br /><span class=\"strong\">Annette</span>: Oh, I'm not sure that would work."}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": " Asking for Targeted Clarifications "}, {"type": "describer", "content": " We ask for targeted clarification when we are not sure what the other person is talking about exactly. We then ask him/her to provide more information."}, {"type": "example", "content": "Which one are you referring to?"}, {"type": "example", "content": "Could you tell me more about... ?"}, {"type": "example", "content": "Can you be more specific?"}, {"type": "example", "content": "Can you explain that?"}, {"type": "example", "content": "What exactly do you mean by...?"}, {"type": "example", "content": "What are you really concerned about?"}]}, {"type": "background_image", "content": "engenn4le18ob09re1img01.jpg"}, {"type": "target_word", "contents": [{"type": "name", "content": "satisfying"}, {"type": "definition", "content": "describes something that makes you feel good or gives you what you want or need "}, {"type": "part_speech", "content": " (adjective)"}, {"type": "example", "content": "Example: My father retired after a long satisfying career."}, {"type": "audio", "content": "engenn4le18ob09aud04"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": " These are words you use when you talk about your job."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "That's good to hear "}, {"type": "definition", "content": "when you hear positive comments or some good news from someone "}, {"type": "part_speech", "content": "(expression)"}, {"type": "example", "content": "Example: Alan: I'm really enjoying my new job. Annette: That's good to hear!"}, {"type": "audio", "content": "engenn4le18ob09aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "anything I can do"}, {"type": "definition", "content": "an expression that is used when you offer to help someone"}, {"type": "part_speech", "content": "(expression)"}, {"type": "example", "content": "Example: Alan, I know that project is tough. If there is anything I can do, please let me know."}, {"type": "audio", "content": "engenn4le18ob09aud01"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to hesitate "}, {"type": "definition", "content": "to stop briefly when you are not sure what to do or what to decide "}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: He hesitated in accepting the job because the office is far from home."}, {"type": "audio", "content": "engenn4le18ob09aud06"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to review"}, {"type": "definition", "content": " to read or discuss again about work or a process to make it better  "}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: The manager and I review my job regularly to make all the tasks easier to finish."}, {"type": "audio", "content": "engenn4le18ob09aud07"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "productive "}, {"type": "definition", "content": "getting a lot of work done in a certain amount of time "}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: I had a productive afternoon because I didn't receive any phone calls."}, {"type": "audio", "content": "engenn4le18ob09aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "nerve-racking "}, {"type": "definition", "content": "describes something that makes you really nervous"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: The job interview this morning was a nerve-racking experience."}, {"type": "audio", "content": "engenn4le18ob09aud02"}]}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Ask a friend to tell you all about his/her job."}, {"type": "text", "content": "Prepare a performance evaluation for him/her. Write down what questions you would ask."}, {"type": "text", "content": "Write comments on your friend's responses. "}, {"type": "text", "content": "Decide what rating you would give your friend on his/her job performance so far. For example: <br/>&#9745; Excellent<br/>&#9745;  Good<br/>&#9745; Still Learning"}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I ask about jobs or work in English."}, {"type": "text", "content": "I write and ask questions for an evaluation interview."}, {"type": "text", "content": "I write comments about good or poor job performance."}]}], "type": "sena"}