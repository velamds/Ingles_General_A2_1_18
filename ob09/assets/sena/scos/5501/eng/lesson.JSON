text"}, {"content": "You have 2 attempts to submit your answers.", "type": "text"}], "type": "post_instructions"}], "type": "TYP", "id": 11}], "stimuli": [{"template_override": 1, "contents": [{}], "_data": [], "type": "welcome", "id": 0}, {"template_override": 1, "title": "", "_data": [], "type": "audio", "id": 1, "contents": [{"value": {"images": [{"time": "", "id": 0, "image": "engenn4le18ob09re2img05.jpg", "text": ""}, {"time": "1", "id": 1, "image": "engenn4le18ob09re2img05.jpg", "text": "<span class=\"strong\">Celine</span>: So, Peter, how are you feeling about your job so far?<br />\n<span class=\"strong\">Peter</span>: Well, it's incredibly challenging but quite satisfying at the same time.<br />\n<span class=\"strong\">Celine</span>: That's good to hear. If there is anything I can do, don't hesitate to ask.<br />\n<span class=\"strong\">Peter</span>: In fact, I'm quite anxious about my upcoming performance review. Do you have any advice for me?"}, {"time": "22500", "id": 2, "image": "engenn4le18ob09re2img01.jpg", "text": "<span class=\"strong\">Celine</span>: Sure. What area would you like advice on exactly?<br /><span class=\"strong\">Peter</span>: Am I prompt for work every day?<br />\n<span class=\"strong\">Celine</span>: You sure are. Can I suggest you set an alarm on your phone?<br />\n<span class=\"strong\">Peter</span> : Yeah, that's a great idea. Am I productive every day and meeting all the goals?"}, {"time": "40000", "id": 3, "image": "engenn4le18ob09re2img03.jpg", "text": "<span class=\"strong\">Celine</span>: Absolutely. What are you really concerned about?<br />\n<span class=\"strong\">Peter</span>: Well, their questions are always a bit nerve-wracking.<br />\n<span class=\"strong\">Celine</span>: Relax, and just focus on your job.<br />\n<span class=\"strong\">Peter</span>: Thanks. I appreciate your input."}], "audiosrc": "engenn4le18ob09re2aud01", "coverimg": "engenn4le18ob09re2img05.jpg"}, "type": "slideshow"}]}], "id": 0, "type": "scholar", "_data": [{"contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}], "type": "lab_options"}]}], "_data": [{"contents": [{"content": "Vanessa's Part-Time Job", "type": "lesson_name"}, {"content": "The Performance Review", "type": "unit_name"}, {"content": 9, "type": "position"}, {"content": "scholar > Achievement Test > Achievement Test", "type": "origin"}, {"content": 18, "type": "lesson"}, {"content": "A2.1", "type": "level"}], "type": "metadata"}, {"contents": [{"content": "false", "type": "test"}], "type": "achievment_test"}, {"contents": [{"content": " Use information about personal and professional plans for the future in social and work situations.", "type": "primary"}, {"content": " Identifies general information in short written or spoken conversations.", "type": "secondary_1"}, {"content": " Identifies general information in short written or spoken conversations.", "type": "secondary_2"}, {"content": " Identifies general information in short written or spoken conversations.", "type": "secondary_3"}, {"content": " Identifies general information in short written or spoken conversations.", "type": "secondary_4"}, {"content": " Identifies general information in short written or spoken conversations.", "type": "secondary_5"}, {"content": " Identifies general information in short written or spoken conversations.", "type": "secondary_6"}, {"content": " Identifies general information in short written or spoken conversations.", "type": "secondary_7"}, {"content": " Identifies general information in short written or spoken conversations.", "type": "secondary_8"}], "type": "objectives"}, {"contents": [{"content": " Responding to Suggestions ", "type": "heading"}, {"content": " It's important to respond to suggestions others make. We can politely express that we like the idea or not. <br />  <br />Look at the chart below.", "type": "describer"}, {"content": "{\"rows\":4,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\"> Accepting a Suggesting </span> \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\"> Declining a Suggestion </span> \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Yeah, that sounds great. Thank you.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" I don't think so, but thanks anyway.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" That's a great idea. Thanks.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" I don't know if that's a good idea. Thanks anyway.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" I like that. Thanks.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" I'm not sure that would work. Thanks anyway.\\\"}\"],\"styles\":\" instruction_table_background intro_table_border\"}", "type": "table"}, {"content": "<span class=\"strong\">Alan</span>: Why don't we ask John to come to the meeting?<br ><span class=\"strong\">Annette</span>: Hey, that's a great idea.", "type": "example"}, {"content": "<span class=\"strong\">Alan</span>: Could we maybe hang that chart on the back of the door?<br /><span class=\"strong\">Annette</span>: Oh, I'm not sure that would work.", "type": "example"}], "type": "learning_points"}, {"contents": [{"content": " Asking for Targeted Clarifications ", "type": "heading"}, {"content": " We ask for targeted clarification when we are not sure what the other person is talking about exactly. We then ask him/her to provide more information.", "type": "describer"}, {"content": "Which one are you referring to?", "type": "example"}, {"content": "Could you tell me more about ... ?", "type": "example"}, {"content": "Can you be more specific?", "type": "example"}, {"content": "Can you explain that?", "type": "example"}, {"content": "What exactly do you mean by ...?", "type": "example"}, {"content": "What are you really concerned about?", "type": "example"}], "type": "learning_points"}, {"content": "engenn4le18ob09re1img01.jpg", "type": "background_image"}, {"contents": [{"content": "satisfying", "type": "name"}, {"content": "making you feel good or giving you what you want or need ", "type": "definition"}, {"content": " (adjective)", "type": "part_speech"}, {"content": "Example: My father retired after a long satisfying career.", "type": "example"}, {"content": "engenn4le18ob09aud04", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": " These are words you use when you talk about your job.", "type": "text"}], "type": "target_word_describer"}, {"contents": [{"content": "That's good to hear!", "type": "name"}, {"content": "That's good news!/I'm happy to hear that!", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: Alan: I'm really enjoying my new job. Annette: That's good to hear!", "type": "example"}, {"content": "engenn4le18ob09aud05", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "anything I can do", "type": "name"}, {"content": "an expression that is used when you offer to help someone", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: Alan, I know that project is tough. If there is anything I can do, please let me know.", "type": "example"}, {"content": "engenn4le18ob09aud01", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "to hesitate ", "type": "name"}, {"content": "to stop briefly when you are not sure what to do or what to decide ", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: He hesitated in accepting the job because the office is far from home.", "type": "example"}, {"content": "engenn4le18ob09aud06", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "to review", "type": "name"}, {"content": " to read or discuss work again", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: The manager and I review my job regularly to make all the tasks easier to finish.", "type": "example"}, {"content": "engenn4le18ob09aud07", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "productive ", "type": "name"}, {"content": "getting a lot of work done in a certain amount of time ", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: I had a productive afternoon because I didn't receive any phone calls.", "type": "example"}, {"content": "engenn4le18ob09aud03", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "nerve-wracking ", "type": "name"}, {"content": "making you feel really nervous", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: The job interview this morning was a nerve-wracking experience.", "type": "example"}, {"content": "engenn4le18ob09aud02", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "Ask a friend to tell you all about his/her job.", "type": "text"}, {"content": "Prepare a performance evaluation for him/her. Write down what questions you would ask.", "type": "text"}, {"content": "Write comments on your his/her responses. ", "type": "text"}, {"content": "Decide what rating you would give your friend on his/her job performance so far. For example: <br/>&#9745; Excellent<br/>&#9745;  Good<br/>&#9745; Still Learning", "type": "text"}], "type": "takeaway_extension"}, {"contents": [{"content": "I ask about jobs or work in English.", "type": "text"}, {"content": "I write and ask questions for an evaluation interview.", "type": "text"}, {"content": "I write comments about good or poor job performance.", "type": "text"}], "type": "takeaway_assessment"}], "type": "sena"}