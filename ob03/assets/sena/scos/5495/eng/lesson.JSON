{"_data": [{"type": "metadata", "contents": [{"content": "Vanessa's Part-Time Job", "type": "lesson_name"}, {"content": "Please, Fill This Out", "type": "unit_name"}, {"content": 3, "type": "position"}, {"content": "scholar > Achievement Test > Achievement Test", "type": "origin"}, {"content": 18, "type": "lesson"}, {"content": "A2.1", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Describe common activities at work to a visitor using short sentences.", "type": "primary"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_1"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_2"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_3"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_4"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_5"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_6"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_7"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_8"}]}, {"content": "engenn4le18ob03re1img01.jpg", "type": "background_image"}, {"type": "learning_points", "contents": [{"content": "Requesting and Replying to Requests for Information", "type": "heading"}, {"content": " ", "type": "describer"}, {"content": "<span class=\"strong\">Manager</span>: I need you to fill out this form for me.<br/><span class=\"strong\">Ann</span>: Certainly.", "type": "example"}, {"content": "When you need to ask a stranger for work information, you use expressions like <span class=\"italic\">Excuse me ...</span> or <span class=\"italic\">Sorry ...</span> to get their attention.<br/><br/>  When you provide information to a stranger about your place of work, you can reply with an offer of help like <span class=\"italic\">How can I help you?</span>", "type": "text"}, {"content": "{\"rows\":2,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Requesting Information\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Providing Information\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"I need you to fill out this form for me.<br/> Is your schedule flexible?<br/> Do you have any questions about the job?<br/>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Certainly. <br/> Cooking is my passion.<br/> Yes ...<br/> You need to deal with pressure.<br/> The sous-chef reports to the chef.<br/>\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}", "type": "table"}, {"content": " <span class=\"italic\">I need you to help me to cook this food. </span>", "type": "example"}, {"content": "The verb \"need\" is used when making a request. We use the pattern \"need someone to do something\". ", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "to report to", "type": "name"}, {"content": "to answer to a superior at work", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: The sous-chef reports to the chef.", "type": "example"}, {"content": "engenn4le18ob03aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": " These are words you use in a conversation about a job application.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "pressure ", "type": "name"}, {"content": "stress; demands", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: There is a lot of pressure on the sous-chef at dinner time.", "type": "example"}, {"content": "engenn4le18ob03aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to deal with", "type": "name"}, {"content": "to take actions in order to solve a problem", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: You need to be able to deal with pressure.", "type": "example"}, {"content": "engenn4le18ob03aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to prep", "type": "name"}, {"content": "to prepare dishes and ingredients in a restaurant", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: The line cook preps the ingredients.", "type": "example"}, {"content": "engenn4le18ob03aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to improvise", "type": "name"}, {"content": "to achieve something without preparation", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: The sous-chef needs to be able to improvise sometimes.", "type": "example"}, {"content": "engenn4le18ob03aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "flexible", "type": "name"}, {"content": "not fixed; able to change", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: Is your schedule flexible?", "type": "example"}, {"content": "engenn4le18ob03aud02", "type": "audio"}]}, {"type": "takeaway_extension", "contents": [{"content": "You are a restaurant manager.", "type": "text"}, {"content": "An applicant comes in to inquire about a job position in your restaurant.", "type": "text"}, {"content": "Write a dialogue (8-10 lines) about the situation.", "type": "text"}, {"content": "Describe what the job is about and what the applicant needs to do.", "type": "text"}, {"content": "Change roles with your partner.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I write a dialogue between a manager and a potential applicant.", "type": "text"}