ry_8"}]}, {"content": "engenn4le18ob01re1img01.jpg", "type": "background_image"}, {"type": "learning_points", "contents": [{"content": "Talking About Plans and Intentions", "type": "heading"}, {"content": "You use the Present Continuous tense and <span class=\"italic\">be going to</span> to talk about future actions and events.", "type": "describer"}, {"content": " You use the Present Continuous to talk about arrangements and plans.<br/> You use <span class=\"italic\">be going to</span> to put an emphasis on an intention (deciding  to do something).<br/><br/>   e.g., <span class=\"italic\">I'm sending some applications soon.</span> vs. <span class=\"italic\">I'm going to send some applications soon.</span> <br/> You can use <span class=\"italic\">intend to</span> in place of <span class=\"italic\">be going to</span>.", "type": "text"}, {"content": "I'm going to practice my craft as much as possible.", "type": "example"}, {"content": "I'm also thinking of moving back to Cambridge.", "type": "example"}]}, {"type": "target_word", "contents": [{"content": "opening", "type": "name"}, {"content": "a new work position", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: There is an opening at a great place nearby.", "type": "example"}, {"content": "engenn4le18ob01aud03", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": "These are words you use when you talk about a new job opportunity.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "to move back", "type": "name"}, {"content": "to go back to your previous place of residence", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: I intend to move back to Cambridge.", "type": "example"}, {"content": "engenn4le18ob01aud07", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "skill ", "type": "name"}, {"content": "ability; something you are good at", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: The new job is a good opportunity to improve my skills.", "type": "example"}, {"content": "engenn4le18ob01aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to hone", "type": "name"}, {"content": "to get better at doing something", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: That would be a great opportunity to hone your skills.", "type": "example"}, {"content": "engenn4le18ob01aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "craft", "type": "name"}, {"content": "an activity that involves skill", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I'm going to practice my craft as much as possible.", "type": "example"}, {"content": "engenn4le18ob01aud01", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "kitchen", "type": "name"}, {"content": "the place where you prepare food", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I need more experience in the kitchen.", "type": "example"}, {"content": "engenn4le18ob01aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to meet ", "type": "name"}, {"content": "to reach; to succeed in doing something ", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: I have a lot of deadlines to meet.", "type": "example"}, {"content": "engenn4le18ob01aud06", "type": "audio"}]}, {"type": "takeaway_extension", "contents": [{"content": "Think of your ideal job. What kind of job is it?", "type": "text"}, {"content": "Go online and find information about it.", "type": "text"}, {"content": "Write a short paragraph (8-10 lines) to describe the job.", "type": "text"}, {"content": "Say why you would love to have this job.", "type": "text"}, {"content": " Read your paragraph to your partner. ", "type": "text"}, {"content": "Listen to your partner's paragraph and exchange advice.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I describe my ideal job in a paragraph.", "type": "text"}, {"content": "I express my feelings about my ideal job.", "type": "text"}, {"content": "I give advice to a partner.", "type": "text"}]}]}