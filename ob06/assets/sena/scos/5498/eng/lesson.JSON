dback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "allowed_attempts": 2}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}, {"content": "Reading", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Instructions: Complete the following steps. Fill in the Self-Assessment. ", "type": "text"}]}], "type": "DWS", "template_override": 1}], "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}]}], "_data": [{"type": "metadata", "contents": [{"content": "Vanessa's Part-Time Job", "type": "lesson_name"}, {"content": "What Not to Wear", "type": "unit_name"}, {"content": 6, "type": "position"}, {"content": "scholar > Achievement Test > Achievement Test", "type": "origin"}, {"content": 18, "type": "lesson"}, {"content": "A2.1", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Identify ways of improving aspects of the use of expressions, structures and vocabulary according to the learning outcomes of level Elementary A.", "type": "primary"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_1"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_2"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_3"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_4"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_5"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_6"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_7"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_8"}]}, {"content": "engenn4le18ob06re1img01.jpg", "type": "background_image"}, {"type": "learning_points", "contents": [{"content": " Asking for Targeted Clarification", "type": "heading"}, {"content": " You ask for targeted clarification when you want more details of what the other person is talking about.", "type": "describer"}, {"content": " We often ask for targeted clarification when we are not clear on what the other person is referring to. We ask the other person to be more specific by giving more information. ", "type": "text"}, {"content": "{\"rows\":3,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Question</span> \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Meaning</span> \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" What do you mean by that?\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" What are you really trying to say?\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Can you be more specific?\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Can you give me more details?\\\"}\"],\"styles\":\" instruction_table_background intro_table_border\"}", "type": "table"}, {"content": "<span class=\"strong\">Manager</span>: Casual shoes shouldn't be worn to the office.<br /><span class=\"strong\">Employee</span>: I'm sorry, but can you be more specific?<br /><span class=\"strong\">Manager</span>: Flip-flops and sneakers are not permitted.", "type": "example"}, {"content": "We use modals (<span class=\"italic\">should</span> and <span class=\"italic\">could</span>) when asking for and responding to advice. ", "type": "text"}]}, {"type": "learning_points", "contents": [{"content": " Formal vs. Casual Clothes", "type": "heading"}, {"content": " Some workplaces have certain dress codes - rules about what you can wear at work.", "type": "describer"}, {"content": " In certain companies, you can wear casual clothing. In some other formal workplaces, you are not allowed to wear certain types of clothing.", "type": "text"}, {"content": "{\"rows\":4,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Formal\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Informal\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" black or brown dress shoes\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" sporty shoes, sneakers\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" dress shirts with collars\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" T-shirts\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" suits, dress pants\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"jeans\\\"}\"],\"styles\":\" instruction_table_background intro_table_border\"}", "type": "table"}, {"content": "I got a job with an IT company, and I can wear jeans and sneakers to work.", "type": "example"}, {"content": "At the bank, you can't wear a T-shirt and running shoes.", "type": "example"}]}, {"type": "target_word", "contents": [{"content": "appropriate ", "type": "name"}, {"content": "what is proper or acceptable to do", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: It is not appropriate to open someone's desk drawers when you go into their office.", "type": "example"}, {"content": "engenn4le18ob06aud02", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": "These are words you  use when you talk about what's proper to wear at work.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "tucked", "type": "name"}, {"content": "when the bottom of a shirt is placed neatly into the waistband of pants", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: When men wear a business shirt, it should always be tucked in.", "type": "example"}, {"content": "engenn4le18ob06aud09", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "open-toed", "type": "name"}, {"content": "describes sandals with uncovered toes", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: Men should definitely not wear open-toed sandals in an office. ", "type": "example"}, {"content": "engenn4le18ob06aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "sneakers", "type": "name"}, {"content": "running shoes or other sporty shoes", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Sneakers are comfortable but not advisable for work.", "type": "example"}, {"content": "engenn4le18ob06aud08", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "flip-flops", "type": "name"}, {"content": "rubber sandals that separate the big toe from the second toe", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Flip-flops are great for the beach but not acceptable at work.", "type": "example"}, {"content": "engenn4le18ob06aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "acceptable", "type": "name"}, {"content": "what is accepted by others   ", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: Ironed straight leg cotton pants are acceptable in an office.", "type": "example"}, {"content": "engenn4le18ob06aud01", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "conservative", "type": "name"}, {"content": "moderate; not liking or accepting changes or new ideas", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: Most people wear conservative clothing.", "type": "example"}, {"content": "engenn4le18ob06aud03", "type": "audio"}]}, {"type": "takeaway_extension", "contents": [{"content": "Think about different events/situations you can be in your city or hometown. (a job interview, BBQ party, etc.)", "type": "text"}, {"content": "Write each event/situation on a card.", "type": "text"}, {"content": "Take turns picking up a card and reading it to a partner. ", "type": "text"}, {"content": "Give your partner different pieces of advice on what to wear or what not to wear.", "type": "text"}, {"content": "When all the cards are finished, choose the best advice for each situation. ", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I write about different environments.", "type": "text"}, {"content": "I talk about what is appropriate to wear in different events/situations.", "type": "text"}, {"content": "I discuss the best piece of advice for each situation.", "type": "text"}]}], "type": "sena"}