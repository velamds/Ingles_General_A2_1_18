r", "id": 0}], "type": "sena", "_data": [{"type": "metadata", "contents": [{"content": "Vanessa's Part-Time Job", "type": "lesson_name"}, {"content": "Dress Code", "type": "unit_name"}, {"content": 5, "type": "position"}, {"content": "scholar > Achievement Test > Achievement Test", "type": "origin"}, {"content": 18, "type": "lesson"}, {"content": "A2.1", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Identify ways of improving aspects of the use of expressions, structures and vocabulary according to the learning outcomes of level Elementary A.", "type": "primary"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_1"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_2"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_3"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_4"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_5"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_6"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_7"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_8"}]}, {"content": "engenn4le18ob05re1img01.jpg", "type": "background_image"}, {"type": "learning_points", "contents": [{"content": "Expressing Uncertainty", "type": "heading"}, {"content": "You express uncertainty when you are not sure whether something can happen, or whether something is true or not.<br/> You can use expressions like <span class=\"italic\">Hang on\u2026</span>, or<span class=\"italic\"> I'm not sure</span> to show uncertainty.", "type": "describer"}, {"content": "<span class=\"strong\">Ann</span>: I'm not sure about the manager's decision.<br/> <span class=\"strong\">Bob</span>: I suppose there are a lot of applicants.", "type": "example"}, {"content": "{\"rows\":5,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Expressions\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Meaning\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Hang on...\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"You need a moment to think about it.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"I guess...\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"You agree with the information.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"I'm not sure...\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"You don't think you know or agree.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"I suppose...\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"You may know or agree, but are not sure about it.\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}", "type": "table"}]}, {"type": "learning_points", "contents": [{"content": "Formal vs. Casual Clothes", "type": "heading"}, {"content": "Certain companies have specific dress codes. In some situations, you must wear formal clothes at all times. <br/> In other situations, you can wear casual clothes on Fridays in North American companies.", "type": "describer"}, {"content": "Here is a list of formal and casual clothes and expressions:", "type": "text"}, {"content": "{\"rows\":2,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Formal\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Casual\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"collared shirt <br/> chef's whites  <br/> business attire  <br/> checkered pants  <br/> tie  <br/>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"jeans  <br/> casual Friday  <br/> T-shirt  <br/> sport shoes  <br/> shorts  <br/>\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}", "type": "table"}]}, {"type": "target_word", "contents": [{"content": "collared shirt", "type": "name"}, {"content": "a formal shirt with a buttoned-up part above the neckline", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I need to see a picture of you wearing a collared shirt!", "type": "example"}, {"content": "engenn4le18ob05aud06", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": "These are words you use when you talk about work clothes.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "applicant ", "type": "name"}, {"content": "a person who applies for a job", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I suppose there are many applicants for the job.", "type": "example"}, {"content": "engenn4le18ob05aud01", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "jeans", "type": "name"}, {"content": "a type of informal trousers, usually blue", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I can't wear jeans at work! It's formal attire only!", "type": "example"}, {"content": "engenn4le18ob05aud07", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "casual Friday", "type": "name"}, {"content": "in North America, the day when employees can wear informal clothes", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: I can wear jeans on casual Friday.", "type": "example"}, {"content": "engenn4le18ob05aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "chef's whites", "type": "name"}, {"content": "a chef's formal uniform", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I need to wear chef's whites in the kitchen.", "type": "example"}, {"content": "engenn4le18ob05aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "toque", "type": "name"}, {"content": "a tall, white hat worn by a chef", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I have to wear my toque every day.", "type": "example"}, {"content": "engenn4le18ob05aud08", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "business attire", "type": "name"}, {"content": "clothing appropriate for the work place", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I need to wear business attire at work.", "type": "example"}, {"content": "engenn4le18ob05aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "casual", "type": "name"}, {"content": "informal", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: I guess you just look like a casual kind of guy.", "type": "example"}, {"content": "engenn4le18ob05aud03", "type": "audio"}]}, {"type": "takeaway_extension", "contents": [{"content": "Go online and find information on dress codes 3 different countries.", "type": "text"}, {"content": "Look for dress codes at work. Is it business attire only? Describe the clothes people wear.", "type": "text"}, {"content": "Look for dress codes in casual situations. When do people wear casual clothes?", "type": "text"}, {"content": "Write a paragraph (8-10 lines) about the information you find.", "type": "text"}, {"content": " Read your paragraph aloud to a partner.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I read about dress codes at work.", "type": "text"}, {"content": "I talk about clothing and work attire.", "type": "text"}, {"content": "I write a paragraph about proper clothing.", "type": "text"}]}]}