: [{"type": "primary", "content": "Use information about personal and professional plans for the future in social and work situations."}, {"type": "secondary_1", "content": "Identifies general information in short written or spoken conversations."}, {"type": "secondary_2", "content": "Identifies general information in short written or spoken conversations."}, {"type": "secondary_3", "content": "Identifies general information in short written or spoken conversations."}, {"type": "secondary_4", "content": "Identifies general information in short written or spoken conversations."}, {"type": "secondary_5", "content": "Identifies general information in short written or spoken conversations."}, {"type": "secondary_6", "content": "Identifies general information in short written or spoken conversations."}, {"type": "secondary_7", "content": "Identifies general information in short written or spoken conversations."}, {"type": "secondary_8", "content": "Identifies general information in short written or spoken conversations."}]}, {"type": "background_image", "content": "engenn4le18ob04re1img01.jpg"}, {"type": "learning_points", "contents": [{"type": "heading", "content": "The Silent E"}, {"type": "describer", "content": "There are 5 spelling rules for the silent e."}, {"type": "table", "content": "{\"rows\":6,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Rules\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Example\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"1. A final e makes the vowel say its name.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"cut, cute\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"2. English words don't end in v or u.  The e after v or u does not affect pronunciation.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"have, blue\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"3. Silent e after the letter c and g \u201csoften\u201d their sounds.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"rage, cabbage, face, experience\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"4. Every syllable must have a vowel. The final syllable can be pronounced without a vowel but every syllable must have a vowel.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"tackle, pickle\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"5. Sometimes the silent final e has no purpose.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"are, were\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": "These are words you use in a conversation about jobs."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "not just a pretty face"}, {"type": "definition", "content": "to be both attractive <span class=\"italic\">and</span> intelligent "}, {"type": "part_speech", "content": " (expression)"}, {"type": "example", "content": "Example: I'm not just a pretty face."}, {"type": "audio", "content": "engenn4le18ob04aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "nothing to lose"}, {"type": "definition", "content": "when you cannot make things worse"}, {"type": "part_speech", "content": " (expression)"}, {"type": "example", "content": "Example: I am going to talk to my boss because I have nothing to lose."}, {"type": "audio", "content": "engenn4le18ob04aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to think ahead"}, {"type": "definition", "content": "to consider or think about the future"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: You are always thinking ahead."}, {"type": "audio", "content": "engenn4le18ob04aud09"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "skills"}, {"type": "definition", "content": "abilities that come from training, experience, or practice"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: What skills do you have?"}, {"type": "audio", "content": "engenn4le18ob04aud06"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to hire"}, {"type": "definition", "content": "to give work or a job to a person"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: If you have experience, they might hire you."}, {"type": "audio", "content": "engenn4le18ob04aud08"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "candidate"}, {"type": "definition", "content": "a person who is applying for a job"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: There were many candidates for the position."}, {"type": "audio", "content": "engenn4le18ob04aud01"}]}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Go online and research a job you would like."}, {"type": "text", "content": "Make a list of the skills and qualifications you need for the job."}, {"type": "text", "content": "Write three sentences that explain why you are the perfect candidate for the job."}, {"type": "text", "content": "Read the sentences to a partner. "}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I read about jobs online."}, {"type": "text", "content": "I make a list of skills and qualifications."}, {"type": "text", "content": "I write sentences using skills and qualifications."}, {"type": "text", "content": "I read the sentences to a partner."}]}]}